# NASA Earthdata Login bearer token (do not commit real values)
# Generate at https://urs.earthdata.nasa.gov/ — never expose to a frontend.
EARTHDATA_TOKEN=

# Optional username/password for earthaccess / netrc-style flows
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# CDS API for ERA5-Land (requires separate Copernicus CDS account + accepted licences)
# https://cds.climate.copernicus.eu/
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Supabase (optional — local filesystem storage is used when unset)
# Use the project URL + secret (service) key on the server only.
# Publishable key is for browser/mobile clients — never put the secret there.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=bhuvyom-rasters

# Engine paths / behaviour
BHUVYOM_DATA_ROOT=
BHUVYOM_DEFAULT_REGION=bengaluru_bbmp
BHUVYOM_HTTP_TIMEOUT_SECONDS=120
BHUVYOM_MAX_CONCURRENCY=2
BHUVYOM_LOG_LEVEL=INFO
