{
  "$description": "Bengaluru From Orbit — Android design tokens. Values come from the shipped web build (dark only). Units: dp for size/space, sp for text, ms for time. Letter-spacing is in em (multiply by font size).",
  "color": {
    "background":        { "value": "#000000", "use": "Every screen background. Never a gradient." },
    "surface":           { "value": "#050506", "use": "Cards, sheets, tiles" },
    "surfaceRaised":     { "value": "#08080A", "use": "Variable cards, nested surfaces" },
    "glass":             { "value": "#D1050506", "alpha": 0.82, "use": "Controls floating over maps (+ 12dp blur where supported, else solid #0B0B0D)" },
    "onBackground":      { "value": "#F2F2F2", "use": "Primary text, big numbers" },
    "onSurfaceVariant":  { "value": "#C9C9CE", "use": "Secondary text, inactive controls" },
    "body":              { "value": "#B4B4BC", "use": "Paragraphs" },
    "muted":             { "value": "#A0A0A8", "use": "Captions, labels (4.5:1 on black)" },
    "faint":             { "value": "#6E6E76", "use": "Credits, axis labels, disabled. Only at >= 11sp" },
    "outline":           { "value": "#12FFFFFF", "alpha": 0.07, "use": "Hairline dividers" },
    "outlineStrong":     { "value": "#29FFFFFF", "alpha": 0.16, "use": "Control borders, frames" },
    "cyan":   { "value": "#7FE0F0", "use": "Primary accent: eyebrows, active states, 'now', primary button" },
    "blue":   { "value": "#5B8CFF", "use": "Spectrum middle" },
    "mauve":  { "value": "#9A86B8", "use": "Spectrum end" },
    "amber":  { "value": "#E9A15A", "use": "Bengaluru marker, 'past', change/delta values, warnings" },
    "teal":   { "value": "#5FC4D8" },
    "orange": { "value": "#E0905A" }
  },
  "gradient": {
    "spectrum":     { "stops": ["#7FE0F0", "#5B8CFF", "#9A86B8"], "angle": 90, "use": "ONLY: big readout number on the map screen, timeline fill, active toggle pill. Everywhere else use solid colours." },
    "toggleActive": { "stops": ["#7FE0F0", "#5B8CFF"], "angle": 90, "use": "Selected segment of segmented toggles (text #000)" }
  },
  "typography": {
    "fonts": { "display": "Jura (variable, assets/fonts/Jura-Variable.ttf)", "text": "Poppins 300/400/500 (assets/fonts)" },
    "displayHero":   { "font": "Jura", "weight": 300, "size": 44, "lineHeight": 1.0, "tracking": 0.05, "case": "upper" },
    "headline":      { "font": "Jura", "weight": 300, "size": 30, "lineHeight": 1.08, "tracking": 0.04, "case": "upper" },
    "metricXL":      { "font": "Jura", "weight": 300, "size": 72, "lineHeight": 0.95, "tracking": 0.01, "numerals": "tabular" },
    "metricL":       { "font": "Jura", "weight": 300, "size": 44, "lineHeight": 1.0, "numerals": "tabular" },
    "metricM":       { "font": "Jura", "weight": 300, "size": 28, "lineHeight": 1.0, "numerals": "tabular" },
    "eyebrow":       { "font": "Jura", "weight": 400, "size": 12, "tracking": 0.3, "case": "upper", "color": "cyan" },
    "label":         { "font": "Jura", "weight": 400, "size": 11, "tracking": 0.2, "case": "upper", "color": "muted" },
    "titleM":        { "font": "Poppins", "weight": 500, "size": 16, "lineHeight": 1.35 },
    "body":          { "font": "Poppins", "weight": 400, "size": 15, "lineHeight": 1.65, "color": "body" },
    "bodySmall":     { "font": "Poppins", "weight": 400, "size": 13, "lineHeight": 1.6, "color": "body" },
    "caption":       { "font": "Poppins", "weight": 400, "size": 11, "lineHeight": 1.55, "color": "faint" },
    "button":        { "font": "Poppins", "weight": 500, "size": 14 },
    "chip":          { "font": "Poppins", "weight": 400, "size": 13 },
    "navLabel":      { "font": "Poppins", "weight": 500, "size": 12 }
  },
  "space": { "grid": 4, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "section": 40, "sectionLarge": 56, "screenEdge": 20 },
  "radius": { "chip": 18, "control": 24, "pill": 999, "card": 20, "tile": 16, "sheet": 28, "mapFrame": 0, "mini": 12 },
  "size": { "touchTarget": 48, "chipHeight": 36, "controlHeight": 48, "buttonHeight": 52, "navBarHeight": 72, "topBarHeight": 64, "iconButton": 44, "sheetPeek": 196, "timelineBar": 72 },
  "stroke": { "hairline": 1, "boundary": 1.2, "isotherm": 1.0, "isothermMajor": 1.3 },
  "elevation": { "note": "No drop shadows anywhere. Separation comes from black space, 1dp hairlines and the glass fill over maps." },
  "motion": {
    "easeOut":      { "cubicBezier": [0.215, 0.61, 0.355, 1], "from": "GSAP power3.out" },
    "easeInOut":    { "cubicBezier": [0.45, 0, 0.55, 1], "from": "GSAP power2.inOut" },
    "durationTap":      120,
    "durationControl":  200,
    "durationEnter":    450,
    "durationScreen":   350,
    "durationCrossfade": 600,
    "staggerItem":       60,
    "enterOffsetDp":     24,
    "reducedMotion": "Disable all of the above except instant state changes when the system 'Remove animations' setting is on."
  }
}
